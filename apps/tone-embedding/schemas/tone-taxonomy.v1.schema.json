{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tone-embedding.local/schemas/tone-taxonomy.v1.schema.json",
  "title": "Tone Taxonomy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toneDimensions",
    "dimensions",
    "descriptors",
    "strengthScale",
    "avoidRules"
  ],
  "properties": {
    "schemaVersion": { "const": "tone-taxonomy/v1" },
    "toneDimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "descriptorThreshold", "positiveDescriptor", "negativeDescriptor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "descriptorThreshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "positiveDescriptor": { "type": "string", "minLength": 1 },
          "negativeDescriptor": { "type": "string", "minLength": 1 }
        }
      }
    },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "label", "status", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "system", "deprecated"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "strengthScale": { "type": "object" },
    "avoidRules": { "type": "object" }
  }
}
