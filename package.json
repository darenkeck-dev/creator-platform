{
  "name": "media-manager",
  "version": "1.0.1",
  "private": true,
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "infra/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:web:turbo": "turbo run dev --filter=web",
    "dev:darenkeck": "bun run --cwd apps/darenkeck dev",
    "dev:darenkeck:turbo": "turbo run dev --filter=darenkeck",
    "build:darenkeck": "bun run --cwd apps/darenkeck build",
    "build:darenkeck:staging": "bun run --cwd apps/darenkeck build:staging",
    "build:darenkeck:prod": "bun run --cwd apps/darenkeck build:prod",
    "typecheck:darenkeck": "bun run --cwd apps/darenkeck typecheck",
    "lint:darenkeck": "bun run --cwd apps/darenkeck lint",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:infra": "bun run --cwd infra/cdk test",
    "deploy:auth": "set -a && . ./.env && set +a && bun run --cwd infra/cdk deploy:auth",
    "deploy:data": "set -a && . ./.env && set +a && bun run --cwd infra/cdk deploy:data",
    "deploy:vectors": "set -a && . ./.env && set +a && bun run --cwd infra/cdk deploy:vectors",
    "deploy:api": "set -a && . ./.env && set +a && bun run --cwd infra/cdk deploy:api",
    "deploy:processing": "set -a && . ./.env && set +a && bun run --cwd infra/cdk deploy:processing",
    "deploy:darenkeck-site": "set -a && . ./.env && set +a && bun run --cwd infra/cdk deploy:darenkeck-site",
    "deploy:darenkeck:staging": "bash \"./scripts/deploy-darenkeck-static.sh\" staging",
    "deploy:darenkeck:prod": "bash \"./scripts/deploy-darenkeck-static.sh\" prod",
    "deploy:observability": "set -a && . ./.env && set +a && bun run --cwd infra/cdk deploy:observability",
    "allowlist:add-email": "bun run --cwd infra/cdk allowlist:add-email",
    "allowlist:remove-email": "bun run --cwd infra/cdk allowlist:remove-email",
    "allowlist:add-domain": "bun run --cwd infra/cdk allowlist:add-domain",
    "allowlist:remove-domain": "bun run --cwd infra/cdk allowlist:remove-domain"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
